# Password Manager Configuration File
# This file contains application settings and preferences

# Core Settings
dataPath=./data
# Cipher preselected for new entries: aes-256-gcm or chacha20-poly1305
defaultCipher=aes-256-gcm
maxLoginAttempts=3

# Clipboard Settings
clipboardTimeoutSeconds=30
autoClipboardClear=true

# Security Settings
requirePasswordConfirmation=true
minPasswordLength=8

# UI Settings
showEncryptionInCredentials=true
defaultUIMode=auto

# ESP32 Vault (empty espHost = local only; see README "Setting up the ESP32")
espHost=
espPort=443
espCert=esp32/vault/cert.pem
# This device's certificate + key: esp32/pki.sh add <name>
espClientCert=
espClientKey=

# Update/Repository Settings
githubOwner=nikitasmen
githubRepo=password-manager-
autoCheckUpdates=false
updateCheckIntervalDays=7