# pwvault configuration: ~/.config/pwvault/config (or $XDG_CONFIG_HOME/pwvault/config)
# Shared by the GUI, the TUI and clients/python. Relative paths resolve against this folder.
# The app writes this file with defaults on first run; usually you only set espHost.

# Core Settings
# Local vault copy; empty = ~/.local/share/pwvault
dataPath=
# Cipher preselected for new entries: aes-256-gcm or chacha20-poly1305
defaultCipher=aes-256-gcm
maxLoginAttempts=3

# Clipboard Settings
clipboardTimeoutSeconds=30
autoClipboardClear=true

# Security Settings
requirePasswordConfirmation=true
minPasswordLength=8

# UI Settings
showEncryptionInCredentials=true
defaultUIMode=auto

# ESP32 Vault (empty espHost = local only; see README "Setting up the ESP32")
espHost=
# false = device-only: every read goes to the ESP32, nothing is stored on this machine
localCopy=true
espPort=443
# Device files, put here by `esp32/pki.sh install <name>`
espCert=server.pem
espClientCert=device.pem
espClientKey=device.key

# Update/Repository Settings
githubOwner=nikitasmen
githubRepo=password-manager-
autoCheckUpdates=false
updateCheckIntervalDays=7